{
  "name": "chonchetrip",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "typecheck:functions": "tsc -p tsconfig.functions.json",
    "check": "npm run lint && npm run typecheck:functions && npm run build",
    "preview": "vite preview",
    "cloudflare:dev": "npm run build && wrangler pages dev --ip 0.0.0.0 --port 8788",
    "cloudflare:migrate:local": "wrangler d1 migrations apply chonchetrip --local",
    "cloudflare:migrate:remote": "wrangler d1 migrations apply chonchetrip --remote",
    "cloudflare:deploy": "npm run check && wrangler pages deploy"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260830.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "wrangler": "^4.127.1"
  }
}
