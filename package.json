{
  "name": "chonchetrip",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "check:content": "node --experimental-strip-types scripts/audit-content.mjs",
    "check:maps": "node --experimental-strip-types scripts/audit-maps.mjs",
    "check:transit": "node --experimental-strip-types scripts/audit-transit.mjs",
    "check:offline": "node scripts/audit-offline.mjs",
    "check:sync": "node --experimental-strip-types scripts/audit-sync.mjs",
    "check:clock": "node --experimental-strip-types scripts/audit-clock.mjs",
    "vendor:leaflet": "node scripts/vendor-leaflet.mjs",
    "typecheck:functions": "tsc -p tsconfig.functions.json",
    "check": "npm run lint && npm run typecheck:functions && npm run check:content && npm run check:maps && npm run check:transit && npm run check:sync && npm run check:clock && npm run build && npm run check:offline",
    "preview": "vite preview",
    "cloudflare:dev": "npm run build && wrangler dev --ip 0.0.0.0 --port 8788",
    "cloudflare:migrate:local": "wrangler d1 migrations apply chonchetrip --local",
    "cloudflare:migrate:remote": "wrangler d1 migrations apply chonchetrip --remote",
    "cloudflare:deploy": "npm run check && wrangler deploy"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260830.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "leaflet": "1.9.4",
    "oxlint": "^1.79.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "wrangler": "^4.127.1"
  }
}
